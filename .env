SPRING_SCHEDULER_TYPE=jobrunr ;db-scheduler | jobrunr
CONSOLE_SCHEDULER_TYPE=db-scheduler

MASS_INSERT_ENABLED=true
MASS_INSERT_COUNT=10000
MASS_INSERT_SLEEPING_COUNT=10000
MASS_INSERT_BATCH_SIZE=10000
MASS_INSERT_DELAY_MS=0

JOB_RUNR_WORKER_COUNT=10
DB_SCHEDULER_THREADS=10

POLL_INTERVAL_IN_SECONDS=5
POLL_USING_LOCK_AND_FETCH_LOCK_AT_MOST_FOR=0.5
POLL_USING_LOCK_AND_FETCH_LOCK_AT_MOST_FOR_SECONDS=3.0

JVM_ARGS=-Xms256m -Xmx512m -XX:+UseG1GC

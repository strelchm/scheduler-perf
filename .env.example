# Scheduler Performance Comparison - Environment Variables
# Copy this file to .env and modify as needed

# Spring Boot scheduler type: db-scheduler-generic or jobrunr
SPRING_SCHEDULER_TYPE=db-scheduler

# Console application scheduler type: db-scheduler or jobrunr
CONSOLE_SCHEDULER_TYPE=db-scheduler

# Mass insert configuration
MASS_INSERT_COUNT=1000
MASS_INSERT_BATCH_SIZE=1000
MASS_INSERT_DELAY_MS=0

# JobRunr configuration
JOB_RUNR_WORKER_COUNT=4

# db-scheduler configuration
DB_SCHEDULER_THREADS=10

# JVM configuration (applied to both Spring and Console applications)
JVM_ARGS=-Xms256m -Xmx512m -XX:+UseG1GC
